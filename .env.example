DATABASE_URL=file:./data/sikat.db
SESSION_SECRET=replace-with-a-long-random-secret-before-production
APP_URL=http://localhost:3000

# Optional: creates exactly one MANAGER account on first boot if no manager
# account exists yet. Leave unset to skip bootstrapping (e.g. after the first
# manager has been created and you no longer need this). Never commit real
# values for these — set them in your deployment platform's env settings.
INITIAL_MANAGER_BCA_ID=
INITIAL_MANAGER_PASSWORD=
INITIAL_MANAGER_NAME=
