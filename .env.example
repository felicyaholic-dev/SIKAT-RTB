DATABASE_URL=file:./data/sikat.db
SESSION_SECRET=replace-with-a-long-random-secret-before-production
APP_URL=http://localhost:3000

# Optional: bootstrap one or more MANAGER accounts. Every account is forced to
# change this password after the first login. Use a one-line JSON array only in
# your deployment platform; never commit real credentials.
INITIAL_MANAGERS=[]

# Legacy single-manager bootstrap (optional). Keep empty when using
# INITIAL_MANAGERS.
INITIAL_MANAGER_BCA_ID=
INITIAL_MANAGER_PASSWORD=
INITIAL_MANAGER_NAME=

# Optional: WhatsApp Business Platform (Cloud API) credentials from Meta for
# Developers. When both are set, outbound WhatsApp notifications (permit
# decisions, broadcast pings) are sent via approved message templates. Leave
# empty to keep the feature fully off. Never commit real values here.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: SMTP credentials for email notifications (permit decisions,
# broadcast pings) — the "Plan B" channel alongside/instead of WhatsApp.
# When SMTP_HOST, SMTP_USER, and SMTP_PASS are all set, matching emails are
# sent to each resident's registered address. Leave empty to keep this
# feature fully off. Works with any SMTP provider (Gmail app password,
# institutional email, Resend, Brevo, Mailgun, etc). Never commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
