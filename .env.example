DATABASE_URL=file:./data/sikat.db
SESSION_SECRET=replace-with-a-long-random-secret-before-production
APP_URL=http://localhost:3000

# Optional: bootstrap one or more MANAGER accounts. Every account is forced to
# change this password after the first login. Use a one-line JSON array only in
# your deployment platform; never commit real credentials.
INITIAL_MANAGERS=[]

# Legacy single-manager bootstrap (optional). Keep empty when using
# INITIAL_MANAGERS.
INITIAL_MANAGER_BCA_ID=
INITIAL_MANAGER_PASSWORD=
INITIAL_MANAGER_NAME=
